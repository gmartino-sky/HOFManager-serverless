# Discord Configuration
DISCORD_PUBLIC_KEY=your_discord_public_key_here
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# Optional: Guild ID for deploying slash commands (only needed for deploy-commands.js)
# The bot automatically detects guild IDs from Discord interactions
#GUILD_ID=your_guild_id_here

# Environment
NODE_ENV=development
STAGE=dev

# Role Configuration (Optional - can be set via /config-roles command)
# If not set, the bot will check DynamoDB for guild-specific role configuration
CLAN_LEADER_ROLE_ID=
CLAN_MEMBER_ROLE_ID=

